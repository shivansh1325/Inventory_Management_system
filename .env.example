# PostgreSQL connection string (Render Postgres, Neon, or local).
#   Render:  use the INTERNAL connection string on the web service,
#            the EXTERNAL one from your local machine.
#   Neon:    use the pooled connection string.
#   Local:   docker run -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL="postgresql://user:password@host:5432/inventory"

# Session signing secret (any long random string) — REQUIRED.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-long-random-string"

# Optional: first-boot admin account created by scripts/bootstrap.ts when the
# users table is empty (defaults shown).
# ADMIN_EMAIL="admin@demo.local"
# ADMIN_PASSWORD="demo1234"
# ADMIN_NAME="Admin"
