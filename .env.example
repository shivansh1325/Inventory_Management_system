# SQLite (default, zero-setup — single file at prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Session signing secret (any long random string) — REQUIRED
AUTH_SECRET="generate-a-long-random-string"

# PostgreSQL (later): change provider to "postgresql" in prisma/schema.prisma,
# set the URL below, then `npx prisma migrate dev`. Quantity columns can then
# be migrated to native Decimal — see the note at the top of schema.prisma.
# DATABASE_URL="postgresql://user:password@localhost:5432/inventory"
